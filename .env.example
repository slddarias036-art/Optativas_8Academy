# Local: Node 24; no credentials are required for students.
PORT=5173
# Set a long local administrator password before starting (never commit it).
ADMIN_PASSWORD=
# Firebase deployment: public web app configuration, NOT private credentials.
VITE_BACKEND=local
# GitHub Pages project path, e.g. /optativas/; defaults to / locally.
VITE_BASE_PATH=/
# Free online backend: set VITE_BACKEND=supabase for GitHub Pages.
# Current free public deployment: VITE_BACKEND=sheets
VITE_APPS_SCRIPT_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_RECAPTCHA_SITE_KEY=
VITE_FUNCTIONS_REGION=us-central1
